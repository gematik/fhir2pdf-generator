<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOGS" value="./logs"/>

    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %gray(%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC}) %highlight(%level %class{1}): %msg%n%throwable
            </Pattern>
        </layout>
    </appender>

    <appender name="ConsolePdfTransformer"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %gray(%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC}) %highlight(%level) %blue(%logger{0}): %msg%n%throwable
            </Pattern>
        </layout>
    </appender>

    <appender name="ConsolePdfValidator"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %gray(%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC}) %highlight(%level) %green(%logger{0}): %msg%n%throwable
            </Pattern>
        </layout>
    </appender>

    <logger name="de.gematik.fhir2pdf.transformer.PdfTransformer" additivity="false">
        <appender-ref ref="ConsolePdfTransformer"/>
    </logger>

    <logger name="de.gematik.fhir2pdf.validator.PdfValidator" additivity="false">
        <appender-ref ref="ConsolePdfValidator"/>
    </logger>

    <logger name="org.apache.fop.apps.FOUserAgent" level="warn"/>

    <root level="info">
        <appender-ref ref="Console"/>
    </root>
</configuration>